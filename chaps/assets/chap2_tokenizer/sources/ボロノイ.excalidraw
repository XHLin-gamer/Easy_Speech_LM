    {
      "id": "LLSINa416lZFYUdRN9YgV",
      "type": "text",
      "x": 538.0452668468522,
      "y": 907.1168193171453,
      "width": 884.044791457164,
      "height": 110,
      "angle": 0,
      "strokeColor": "#1971c2",
      "backgroundColor": "#a5d8ff",
      "fillStyle": "solid",
      "strokeWidth": 4,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b0c",
      "roundness": null,
      "seed": 1102494034,
      "version": 341,
      "versionNonce": 1701551950,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1793346240552,
      "created": 1793345456345,
      "link": null,
      "locked": false,
      "text": "（1）母点と母点の垂直二等分線によって、\n空間が分割されます。",
      "fontSize": 44,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "（1）母点と母点の垂直二等分線によって、\n空間が分割されます。",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "vlCqS4amr-C7SEM_5XXoK",
      "type": "text",
      "x": 538.0452668791002,
      "y": 1044.9813522418506,
      "width": 884.0447911208998,
      "height": 220,
      "angle": 0,
      "strokeColor": "#2f9e44",
      "backgroundColor": "#a5d8ff",
      "fillStyle": "solid",
      "strokeWidth": 4,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b0cV",
      "roundness": null,
      "seed": 755810702,
      "version": 414,
      "versionNonce": 2016414802,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1793346243858,
      "created": 1793346013048,
      "link": null,
      "locked": false,
      "text": "（2）分割されたある領域の中にある任意の\n点は、他のどの母点よりも、その領域の持ち\n主である母点に最も近い\n",
      "fontSize": 44,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "（2）分割されたある領域の中にある任意の点は、他のどの母点よりも、その領域の持ち主である母点に最も近い\n",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
